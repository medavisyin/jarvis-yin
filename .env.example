# Langfuse (self-hosted). Leave blank to disable tracing.
# Jarvis loads this file at tracing startup (does not override existing process env).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_HOST is an alias for LANGFUSE_BASE_URL if BASE_URL is unset.
# LANGFUSE_HOST=http://localhost:3000
